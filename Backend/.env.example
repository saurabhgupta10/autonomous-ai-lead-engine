# Copy this file to .env and fill in your values.
# Never commit .env or your service-account JSON to version control.

# ── Gemini API (Google AI Studio) ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
# Model identifier, e.g. gemini-flash-lite-latest or gemini-3.5-flash-lite
GEMINI_MODEL=gemini-flash-lite-latest

# ── Google Sheets CRM ─────────────────────────────────────────────────────────
# Sheet ID from the URL: .../spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here
# Name of the worksheet/tab
GOOGLE_WORKSHEET_NAME=Leads
# Path to the downloaded service-account JSON key
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json

# ── OpenStreetMap Compliance ─────────────────────────────────────────────────
# Valid contact email identifying the operator for OSM policy compliance
OSM_CONTACT_EMAIL=operator@example.com
# Hours to cache discovery queries locally to avoid repetitive OSM requests
CACHE_TTL_HOURS=24

# ── API Security & Authentication ────────────────────────────────────────────
# Optional secret token to restrict POST endpoints in production.
# When set, callers must send: Authorization: Bearer <API_BEARER_TOKEN>
# Leave blank for local development mode.
API_BEARER_TOKEN=

# Frontend origins allowed by CORS (comma-separated, e.g. http://localhost:3000,https://my-dashboard.vercel.app)
FRONTEND_ORIGIN=http://localhost:3000

# Comma-separated list of external hostnames that /api/scan may fetch.
# Leave empty to allow only the bundled mock file.
ALLOWED_SCAN_HOSTS=
