# Copy this file to .env and fill in your values.
# Never commit .env or your service-account JSON.

# Google Gemini API key (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model override. gemini-1.5-flash is free-tier friendly.
GEMINI_MODEL=gemini-1.5-flash

# Google Sheet ID from the spreadsheet URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Worksheet/tab name inside the spreadsheet
GOOGLE_WORKSHEET_NAME=Leads

# Path to the Google Cloud service account JSON key
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
