# Copy this file to .env and fill in your values.
# Never commit .env or your service-account JSON to version control.

# ── Gemini ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
# Model identifier, e.g. gemini-flash-lite-latest or gemini-3.5-flash-lite
GEMINI_MODEL=gemini-flash-lite-latest

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Sheet ID from the URL: .../spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here
# Name of the worksheet/tab
GOOGLE_WORKSHEET_NAME=Leads
# Path to the downloaded service-account JSON key
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json

# ── API security ──────────────────────────────────────────────────────────────
# Comma-separated list of external hostnames that /api/scan may fetch.
# Leave empty to allow only the bundled mock file.
# Example: ALLOWED_SCAN_HOSTS=example.com,mybusiness.com
ALLOWED_SCAN_HOSTS=

# Frontend origin allowed by CORS (adjust for production deployment)
FRONTEND_ORIGIN=http://localhost:3000
